# Copy this file to `.env` and edit as needed. All values have sane defaults.

# --- Redis ---
# Leave BLANK to use the built-in in-memory fakeredis (no server needed, great for dev/tests).
# Set to a real Redis to use a server, e.g.:
#   REDIS_URL=redis://localhost:6379/0
#   REDIS_URL=redis://default:PASSWORD@your-redis-cloud-host:port
REDIS_URL=

# --- Rate limiting (token bucket, per API key) ---
RATE_LIMIT_CAPACITY=20          # max burst
RATE_LIMIT_REFILL_PER_SEC=5     # tokens refilled per second

# --- Semantic cache ---
CACHE_ENABLED=true
CACHE_MATCH_MODE=exact          # semantic is opt-in and may reuse an incorrect answer
CACHE_EPOCH=1                  # change when external answer policy/data changes
MAX_REQUEST_BYTES=65536
MAX_CONCURRENT_REQUESTS=64
REQUEST_BODY_TIMEOUT=10
MAX_CACHE_ENTRY_BYTES=65536
MAX_CACHED_TENANTS=16
CACHE_SIMILARITY_BASE=0.72      # base threshold T_base (calibrated for minilm; adaptive logic adjusts up)

# --- Vector index backend ---
# inproc     = in-process NumPy matrix (default; nothing extra to run)
# redisearch = shared HNSW index in Redis Stack (needs REDIS_URL -> a Redis Stack server)
VECTOR_BACKEND=inproc

# --- Embeddings ---
# minilm = real semantic embeddings (sentence-transformers, downloads a ~90MB model once)
# hash   = fast lexical-only embedder, no download (used by tests)
EMBEDDING_BACKEND=minilm
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=256               # only used by the hash backend

# --- API keys allowed to use the gateway (comma-separated). Demo key included. ---
API_KEYS=demo-key-123

# --- Production hardening ---
DAILY_REQUEST_BUDGET=0          # max admitted misses/bypasses per key per UTC day (0 = unlimited; hits are free)
BREAKER_FAIL_THRESHOLD=3        # failures before a provider's circuit breaker opens
BREAKER_WINDOW_SEC=30
BREAKER_COOLDOWN_SEC=20
CACHE_TTL_SEC=3600              # positive lifetime; zero is rejected
MAX_CACHE_ENTRIES_PER_TENANT=256 # positive limit; zero is rejected
METRICS_TOKEN=internal-metrics-token  # token for securing /metrics endpoint
CORS_ORIGINS=                   # empty = same-origin only
PROVIDER_TIMEOUT=30.0           # provider call timeout in seconds

# --- Upstream LLM provider ---
# mock (free, default) | openai | gemini. Real providers never silently fall back to mock answers.
LLM_PROVIDER=mock
# For OpenAI:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# For Gemini (uses Google's OpenAI-compatibility endpoint):
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# --- Cost-aware model cascade (optional) ---
# When enabled, easy queries go to the cheap model and hard ones escalate to the strong model.
CASCADE_ENABLED=false
CASCADE_THRESHOLD=0.35
GEMINI_STRONG_MODEL=gemini-3.5-flash
OPENAI_STRONG_MODEL=gpt-4o

# Set production explicitly to reject demo credentials and missing shared Redis.
ENVIRONMENT=development
# Production: replace with a stable, random secret of at least 32 characters.
API_KEY_SALT=verigate-development-only
# Required only by docker-compose.observability.yml.
GRAFANA_ADMIN_PASSWORD=

# Observability secret file containing the same value as METRICS_TOKEN.
METRICS_TOKEN_FILE=
